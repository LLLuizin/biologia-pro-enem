{
  "name": "biologia-enem",
  "version": "1.0.0",
  "description": "Site de biologia para o ENEM - Conteúdos que caem, explicados para a vida real",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --no-lint && next-sitemap",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "sitemap": "next-sitemap",
    "clean": "rm -rf .next out",
    "postbuild": "next-sitemap"
  },
  "keywords": [
    "biologia",
    "enem",
    "vestibular",
    "estudos",
    "educacao",
    "genetica",
    "ecologia",
    "evolucao",
    "citologia",
    "fisiologia",
    "botanica",
    "zoologia",
    "biotecnologia"
  ],
  "author": "Comunidade Biologia ENEM",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/usuario/biologia-enem"
  },
  "bugs": {
    "url": "https://github.com/usuario/biologia-enem/issues"
  },
  "homepage": "https://biologiaenem.com",
  "dependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.7.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "framer-motion": "^14.14.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.77.0",
    "next": "^14.2.35",
    "next-mdx-remote": "^6.0.0",
    "postcss": "^8.5.33",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.7.1",
    "tailwindcss": "^3.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "eslint-plugin-prettier": "^5.5.7",
    "next-sitemap": "^4.2.3",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=18.17.0"
  },
  "packageManager": "npm@10.0.0"
}
